# Ignore everything unless explicitly allowed below.
/*
!/.gitignore
!/backend/
!/frontend/

# Backend API files
/backend/*
!/backend/BackendApi/
/backend/BackendApi/*
!/backend/BackendApi/BackendApi.csproj
!/backend/BackendApi/Program.cs
!/backend/BackendApi/appsettings.json
!/backend/BackendApi/Controllers/
!/backend/BackendApi/Data/
!/backend/BackendApi/Models/
/backend/BackendApi/Controllers/*
!/backend/BackendApi/Controllers/AuthController.cs
/backend/BackendApi/Data/*
!/backend/BackendApi/Data/AppDbContext.cs
/backend/BackendApi/Models/*
!/backend/BackendApi/Models/User.cs
!/backend/BackendApi/Models/LoginDto.cs
!/backend/BackendApi/Models/RegisterDto.cs

# Frontend application files
/frontend/*
!/frontend/angular.json
!/frontend/ionic.config.json
!/frontend/package.json
!/frontend/pnpm-lock.yaml
!/frontend/pnpm-workspace.yaml
!/frontend/tsconfig.json
!/frontend/tsconfig.app.json
!/frontend/tsconfig.e2e.json
!/frontend/tsconfig.spec.json
!/frontend/.browserslistrc
!/frontend/.editorconfig
!/frontend/.prettierignore
!/frontend/eslint.config.js
!/frontend/playwright.config.ts
!/frontend/vitest.config.mts
!/frontend/e2e/
!/frontend/src/
/frontend/e2e/*
!/frontend/e2e/app.spec.ts
/frontend/src/*
!/frontend/src/app/
!/frontend/src/assets/
!/frontend/src/environments/
!/frontend/src/global.scss
!/frontend/src/index.html
!/frontend/src/main.ts
!/frontend/src/test-setup.ts
!/frontend/src/theme/

/frontend/src/app/*
!/frontend/src/app/app.component.ts
!/frontend/src/app/app.component.html
!/frontend/src/app/app.component.spec.ts
!/frontend/src/app/app.routes.ts
!/frontend/src/app/pages/
!/frontend/src/app/services/
/frontend/src/app/pages/*
!/frontend/src/app/pages/login/
!/frontend/src/app/pages/register/
!/frontend/src/app/pages/profile/
!/frontend/src/app/services/auth.ts
!/frontend/src/app/services/auth.spec.ts

/frontend/src/assets/*
!/frontend/src/assets/icon/
/frontend/src/assets/icon/*
!/frontend/src/assets/icon/favicon.png
/frontend/src/theme/*
!/frontend/src/theme/variables.scss

# Build output, dependencies, caches, and local databases
**/bin/
**/obj/
**/node_modules/
**/www/
**/.angular/
**/.ionic/
**/dist/
**/coverage/
*.db
*.db-wal
*.db-shm
